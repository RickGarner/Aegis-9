<Window x:Class="Aegis.Desktop.WorkflowApprovalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 · Workflow Design Review" Height="700" Width="860" MinHeight="600" MinWidth="720" WindowStartupLocation="CenterOwner" Background="#030A0F">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9F7FF"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="#4DE7FF"/><Setter Property="Background" Value="#D0112733"/><Setter Property="BorderBrush" Value="#6638C9EA"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WORKFLOW DESIGN / REQUIRED REVIEW" Foreground="#4DE7FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HeadingText" FontSize="28" Margin="0,5,0,4"/><TextBlock x:Name="GateText" Foreground="#FFFFB84D"/><TextBlock Text="Workflow-plan approval unlocks test-plan design. Test plans require a separate user approval before code is built. Test results then require user acceptance and supervisor production approval." Foreground="#6A9BA9" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="#B20A1821" BorderBrush="#6638C9EA" BorderThickness="1" Padding="16" Margin="0,18,0,14"><ScrollViewer><StackPanel><TextBlock Text="WORKFLOW REQUEST" Foreground="#6A9BA9" FontSize="10"/><TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,7,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IMPLEMENTATION" Foreground="#6A9BA9" FontSize="10"/><TextBlock x:Name="ImplementationText" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SAFETY STATUS" Foreground="#6A9BA9" FontSize="10"/><TextBlock Text="Production execution disabled until supervisor approval and schedule validation." Foreground="#FFFFB84D" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid><Border x:Name="QuestionStatusBorder" BorderBrush="#88FFB84D" BorderThickness="1" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="REVIEW / CLARIFICATION STATUS" Foreground="#6A9BA9" FontSize="10"/><TextBlock x:Name="QuestionStatusText" Foreground="#FFFFB84D" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><Border BorderBrush="#554DE7FF" BorderThickness="1" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="GuidanceText" TextWrapping="Wrap"/></Border><DockPanel Margin="0,12,0,0"><TextBlock Text="SAFE TEST PROFILE" Foreground="#6A9BA9" FontSize="10" VerticalAlignment="Center"/><ComboBox x:Name="TestProfileInput" DockPanel.Dock="Right" SelectedIndex="0" Width="210"><ComboBoxItem Content="Static validation (recommended)" Tag="static"/><ComboBoxItem Content="Restricted local execution" Tag="restricted"/></ComboBox></DockPanel><TextBlock Text="AI PLAN / GENERATED IMPLEMENTATION / TEST EVIDENCE" Foreground="#6A9BA9" FontSize="10" Margin="0,18,0,5"/><TextBlock x:Name="ModelText" Foreground="#4DE7FF" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox x:Name="ArtifactText" MinHeight="170" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="#D9F7FF" Background="#A908161F" BorderBrush="#6638C9EA" Padding="10"/></StackPanel></ScrollViewer></Border>
  <DockPanel Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#6A9BA9" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="REJECT" Click="RejectButton_Click"/><Button x:Name="AdvanceButton" Content="ADVANCE" Click="AdvanceButton_Click" Margin="0"/></StackPanel></DockPanel>
 </Grid>
</Window>
