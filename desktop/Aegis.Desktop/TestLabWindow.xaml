<Window x:Class="Aegis.Desktop.TestLabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 Test Lab" Height="760" Width="1180" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterOwner" Background="#030A0F" Foreground="#D9F7FF">
 <Window.Resources><SolidColorBrush x:Key="Cyan" Color="#4DE7FF"/><SolidColorBrush x:Key="Panel" Color="#B20A1821"/><SolidColorBrush x:Key="Line" Color="#6638C9EA"/><Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="Background" Value="#18152A36"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style><Style TargetType="TextBox"><Setter Property="Foreground" Value="#D9F7FF"/><Setter Property="Background" Value="#D0051119"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Cyan}"/></Style></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="A · E · G · I · S  TEST LAB" Foreground="{StaticResource Cyan}" FontSize="23"/><TextBlock Text="AI-assisted synthetic testing in a disposable, network-disabled Windows Sandbox" Foreground="#6A9BA9" Margin="0,5,0,14"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourcePathText" IsReadOnly="True" Padding="8" Text="Select a PowerShell or C# source file"/><Button Grid.Column="1" Content="SELECT SOURCE" Click="SelectSource_Click" Margin="9,0,0,0"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="SOURCE COPY" Foreground="{StaticResource Cyan}" FontWeight="Bold" Margin="0,0,0,8"/><TextBox x:Name="SourceText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="RISK REVIEW / TEST PLAN" Foreground="{StaticResource Cyan}" FontWeight="Bold" Margin="0,0,0,8"/><TextBox x:Name="PlanText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel></Border></Grid>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="No source selected. Nothing will execute without plan approval." Foreground="#FFB84D" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="UseAiCheckBox" Content="Use local AI for additional synthetic cases" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="1 · CREATE PLAN" Click="CreatePlan_Click"/><Button x:Name="ApproveButton" Content="2 · APPROVE PACKAGE" Click="ApprovePackage_Click" IsEnabled="False"/><Button x:Name="LaunchButton" Content="3 · LAUNCH SANDBOX" Click="LaunchSandbox_Click" IsEnabled="False"/><Button x:Name="EvidenceButton" Content="4 · REVIEW EVIDENCE" Click="ReviewEvidence_Click" IsEnabled="False" Margin="0"/></StackPanel></DockPanel>
 </Grid>
</Window>
