<Window x:Class="Aegis.Desktop.WorkflowEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 · Workflow Designer" Height="720" Width="900" MinHeight="600" MinWidth="760" WindowStartupLocation="CenterOwner" Background="#030A0F">
 <Window.Resources><SolidColorBrush x:Key="Panel" Color="#B20A1821"/><SolidColorBrush x:Key="Line" Color="#6638C9EA"/><SolidColorBrush x:Key="Text" Color="#D9F7FF"/><SolidColorBrush x:Key="Muted" Color="#6A9BA9"/><SolidColorBrush x:Key="Cyan" Color="#4DE7FF"/><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="Background" Value="#D0112733"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style><Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#A908161F"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="9"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="MISSION DESIGN / AI-ASSISTED WORKFLOW" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HeadingText" Text="Create workflow" FontSize="28" Margin="0,5,0,4"/><TextBlock Text="Describe the outcome, attach supporting documents, and identify anything A.E.G.I.S.-9 must clarify before a runnable plan is generated." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,18,0,14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="WORKFLOW NAME" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="TitleInput" MaxLength="120" Margin="0,5,0,13"/>
   <TextBlock Text="REQUEST / OPERATING INSTRUCTIONS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="DescriptionInput" MaxLength="20000" MinHeight="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,13"/>
   <TextBlock Text="IMPLEMENTATION LANGUAGE" Foreground="{StaticResource Muted}" FontSize="10"/><ComboBox x:Name="LanguageInput" SelectedIndex="0" Margin="0,5,0,13"><ComboBoxItem Content="PowerShell" Tag="powershell"/><ComboBoxItem Content="C#" Tag="csharp"/></ComboBox>
   <DockPanel><TextBlock Text="SOURCE DOCUMENTS" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button Content="UPLOAD DOCUMENTS" DockPanel.Dock="Right" Click="UploadButton_Click" Margin="0"/></DockPanel><ListBox x:Name="AttachmentList" MinHeight="72" Margin="0,6,0,13" Background="#8008161F" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/>
   <Border BorderBrush="#55FFB84D" BorderThickness="1" Padding="10"><TextBlock Text="After Save Draft, the plan-review window opens automatically. Select Design AI Plan. If A.E.G.I.S.-9 needs information, its questions and answer fields open immediately. No production action can occur from this screen." Foreground="#FFFFB84D" TextWrapping="Wrap"/></Border>
  </StackPanel></ScrollViewer></Border>
  <DockPanel Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="CANCEL" Click="CancelButton_Click"/><Button Content="SAVE DRAFT" Click="SaveButton_Click" Margin="0"/></StackPanel></DockPanel>
 </Grid>
</Window>
