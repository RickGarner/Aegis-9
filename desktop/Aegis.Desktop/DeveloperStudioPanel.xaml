<UserControl x:Class="Aegis.Desktop.DeveloperStudioPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="#D9F7FF" FontFamily="Segoe UI">
 <UserControl.Resources>
  <SolidColorBrush x:Key="StudioCyan" Color="#4DE7FF"/>
  <SolidColorBrush x:Key="StudioDim" Color="#6A9BA9"/>
  <SolidColorBrush x:Key="StudioLine" Color="#6638C9EA"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9F7FF"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource StudioCyan}"/><Setter Property="Background" Value="#18152A36"/><Setter Property="BorderBrush" Value="{StaticResource StudioLine}"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#D9F7FF"/></Style>
 </UserControl.Resources>
 <Border Background="#FA07131B" BorderBrush="#B84DE7FF" BorderThickness="1,0,0,0" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="AEGIS DEVELOPMENT ENVIRONMENT" Foreground="{StaticResource StudioCyan}" FontSize="9" FontWeight="Bold"/>
     <TextBlock Text="DEVELOPER STUDIO" FontSize="25" FontWeight="Light" Margin="0,7,0,0"/>
     <TextBlock Text="Local Development Workspace" Foreground="{StaticResource StudioDim}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="CLOSE" Click="CloseButton_Click" VerticalAlignment="Top" Margin="0"/>
   </Grid>

   <Border Grid.Row="1" BorderBrush="{StaticResource StudioLine}" BorderThickness="1" Background="#A20A1821" Padding="14" Margin="0,22,0,0">
    <StackPanel>
     <TextBlock Text="STUDIO FOUNDATION" Foreground="{StaticResource StudioCyan}" FontSize="9" FontWeight="Bold"/>
     <Grid Margin="0,11,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Code - OSS IDE" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="FoundationPathText" Text="Checking configured installation" Foreground="{StaticResource StudioDim}" FontSize="9" TextWrapping="Wrap" Margin="0,3,10,0"/></StackPanel>
      <TextBlock x:Name="FoundationStatusText" Grid.Column="1" Text="CHECKING" Foreground="#FFB84D" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
     </Grid>
     <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="FERAL local assistance" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Provider bridge and live model status arrive in milestone 3" Foreground="{StaticResource StudioDim}" FontSize="9" Margin="0,3,10,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="PLANNED" Foreground="#FFB84D" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel>
   </Border>

   <Border Grid.Row="2" BorderBrush="{StaticResource StudioLine}" BorderThickness="1" Background="#A20A1821" Padding="14" Margin="0,12,0,0">
    <StackPanel>
     <TextBlock Text="ACTIVE REPOSITORY" Foreground="{StaticResource StudioCyan}" FontSize="9" FontWeight="Bold"/>
     <TextBlock x:Name="SelectedRepositoryText" Text="No repository selected" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,9,0,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     <TextBlock x:Name="RepositoryDetailText" Text="Choose a local folder or select a recent repository." Foreground="{StaticResource StudioDim}" FontSize="9" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,13,0,0"><Button Content="BROWSE FOLDER" Click="BrowseFolderButton_Click"/><Button x:Name="OpenStudioButton" Content="OPEN DEVELOPER STUDIO" Click="OpenStudioButton_Click" IsEnabled="False" Margin="0"/></StackPanel>
    </StackPanel>
   </Border>

   <Grid Grid.Row="3" Margin="0,18,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="RECENT REPOSITORIES" Foreground="{StaticResource StudioCyan}" FontSize="9" FontWeight="Bold"/>
    <ListBox x:Name="RecentRepositoriesList" Grid.Row="1" Margin="0,7,0,0" SelectionChanged="RecentRepositoriesList_SelectionChanged">
     <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#3238C9EA" BorderThickness="0,1,0,0" Padding="3,10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource StudioDim}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>

   <Border Grid.Row="4" BorderBrush="#6658DDF5" BorderThickness="1,0,0,0" Padding="12,3" Margin="0,12,0,0">
    <TextBlock x:Name="MilestoneText" Text="MILESTONE 2 · SAFE LAUNCH ACTIVE&#x0a;Developer Studio runs separately; Aegis does not terminate unrelated processes." Foreground="{StaticResource StudioDim}" FontSize="9" TextWrapping="Wrap" LineHeight="16"/>
   </Border>
  </Grid>
 </Border>
</UserControl>
