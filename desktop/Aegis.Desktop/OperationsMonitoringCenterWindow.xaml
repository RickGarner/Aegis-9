<Window x:Class="Aegis.Desktop.OperationsMonitoringCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A.E.G.I.S.-9 · Operations Monitoring Center (Preview)"
        Width="1320" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="Manual" Background="#030A0F" Foreground="#D9F7FF">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#B20A1821"/>
    <SolidColorBrush x:Key="Raised" Color="#D0112733"/>
    <SolidColorBrush x:Key="Line" Color="#6638C9EA"/>
    <SolidColorBrush x:Key="Text" Color="#D9F7FF"/>
    <SolidColorBrush x:Key="Muted" Color="#6A9BA9"/>
    <SolidColorBrush x:Key="Cyan" Color="#4DE7FF"/>
    <SolidColorBrush x:Key="Amber" Color="#FFB84D"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#061119"/><Setter Property="Background" Value="{StaticResource Cyan}"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/></Style>
    <Style x:Key="PanelStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="OPERATIONS / READ-ONLY PREVIEW" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="MONITORING CENTER" Foreground="{StaticResource Cyan}" FontSize="28" FontWeight="Light" Margin="0,4,0,0"/><TextBlock Text="Unified status and navigation · actions remain governed elsewhere" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LAYOUT" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LayoutModeComboBox" Width="120" SelectionChanged="LayoutModeComboBox_SelectionChanged"><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Wallboard"/></ComboBox><Button Content="REFRESH" Click="RefreshButton_Click" Margin="10,0,0,0"/></StackPanel>
    </DockPanel>
    <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,14">
      <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="OVERALL" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="OverallStateText" Text="UNKNOWN" Foreground="{StaticResource Amber}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CRITICAL" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="CriticalCountText" Text="0" FontSize="20"/></StackPanel></Border>
      <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="DEGRADED" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="DegradedCountText" Text="0" FontSize="20"/></StackPanel></Border>
      <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="UNKNOWN" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="UnknownCountText" Text="4" FontSize="20"/></StackPanel></Border>
      <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="HEALTHY" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="HealthyCountText" Text="0" FontSize="20"/></StackPanel></Border>
      <Border Style="{StaticResource PanelStyle}"><StackPanel><TextBlock Text="LAST REFRESH" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="LastRefreshText" Text="NOT LOADED" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="DetailColumn" Width="320"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SYSTEMS AND VIEWS" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Select a resource for normalized evidence. Double-click to open its authoritative monitor." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel><ListBox x:Name="SystemsList" Grid.Row="1" SelectionChanged="SystemsList_SelectionChanged" MouseDoubleClick="SystemsList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#70112733" Padding="9" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TARGET" Foreground="{StaticResource Muted}" FontSize="8"/><TextBlock Text="{Binding TargetState}" Foreground="{Binding TargetBrush}" FontSize="10" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="COLLECTOR" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right"/><TextBlock Text="{Binding CollectorState}" Foreground="{Binding CollectorBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></Grid><TextBlock Text="{Binding Freshness}" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,6,0,0"/><TextBlock Text="{Binding AlertSummary}" Foreground="{StaticResource Amber}" FontSize="9" Margin="0,3,0,0"/><Button Content="OPEN DETAILS" Tag="{Binding MonitorId}" Click="OpenMonitorButton_Click" Margin="0,8,0,0" Padding="7,4"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource PanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="ALERTS / ACTIVITY" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ConnectionStateText" DockPanel.Dock="Right" Text="NOT LOADED" Foreground="{StaticResource Amber}" FontSize="9"/></DockPanel><ListView x:Name="AlertsList" Grid.Row="1" Margin="0,12,0,0"><ListView.View><GridView><GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" Width="90"/><GridViewColumn Header="Source" DisplayMemberBinding="{Binding MonitorId}" Width="120"/><GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="260"/><GridViewColumn Header="Detail" DisplayMemberBinding="{Binding Description}" Width="420"/></GridView></ListView.View></ListView></Grid></Border>
      <Border Grid.Column="4" Style="{StaticResource PanelStyle}"><StackPanel><TextBlock Text="SELECTED DETAILS" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SelectedResourceNameText" Text="No resource selected" FontSize="18" FontWeight="Light" Margin="0,12,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TARGET STATE" Foreground="{StaticResource Muted}" FontSize="8"/><TextBlock x:Name="SelectedTargetStateText" Text="UNKNOWN" Foreground="{StaticResource Cyan}" FontSize="12" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="COLLECTOR STATE" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right"/><TextBlock x:Name="SelectedCollectorStateText" Text="UNKNOWN" Foreground="{StaticResource Amber}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></Grid><TextBlock x:Name="SelectedConfigurationText" Text="Configuration: unknown" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0"/><TextBlock x:Name="SelectedFreshnessText" Text="No observation loaded" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/><TextBlock x:Name="SelectedAlertText" Text="Alerts: unknown" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,12"/><TextBlock x:Name="DetailText" Text="No normalized evidence loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"/><Button x:Name="OpenSelectedDetailsButton" Content="OPEN AUTHORITATIVE MONITOR" Click="OpenSelectedDetailsButton_Click" Margin="0,14,0,0" IsEnabled="False"/><Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="10,2" Margin="0,18,0,0"><TextBlock Text="Target health and collector health are intentionally separate. Missing or stale evidence is never displayed as current healthy state." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border></StackPanel></Border>
    </Grid>
    <StatusBar Grid.Row="3" Background="Transparent" Foreground="{StaticResource Muted}" Margin="0,12,0,0"><StatusBarItem><TextBlock Text="PREVIEW FEATURE FLAG · READ ONLY · NO PRODUCTION ACTIONS"/></StatusBarItem><StatusBarItem HorizontalContentAlignment="Right"><TextBlock Text="Movable · resizable · maximizable · layout retained" Foreground="{StaticResource Cyan}"/></StatusBarItem></StatusBar>
  </Grid>
</Window>
