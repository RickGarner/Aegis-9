<Window x:Class="Aegis.Desktop.WorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A.E.G.I.S.-9 · Supervised Workflow" Height="620" Width="900" MinHeight="500" MinWidth="700" WindowStartupLocation="CenterOwner" Background="#030A0F">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#B20A1821"/><SolidColorBrush x:Key="Raised" Color="#D0112733"/><SolidColorBrush x:Key="Line" Color="#6638C9EA"/><SolidColorBrush x:Key="Text" Color="#D9F7FF"/><SolidColorBrush x:Key="Muted" Color="#6A9BA9"/><SolidColorBrush x:Key="Green" Color="#4DE7FF"/><SolidColorBrush x:Key="Amber" Color="#FFB84D"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Green}"/><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18"><StackPanel DockPanel.Dock="Left"><TextBlock Text="MISSION CONTROL / SUPERVISED AUTOMATION" Foreground="{StaticResource Green}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TitleText" Text="Loading workflow" FontSize="28" FontWeight="Light" Margin="0,5,0,0"/><TextBlock x:Name="DescriptionText" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="StateText" Text="LOADING" Foreground="{StaticResource Amber}" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,14"><DockPanel><TextBlock x:Name="PlacementText" Text="Monitor placement loading" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ConnectionText" Text="CONNECTING" Foreground="{StaticResource Amber}" DockPanel.Dock="Right" Margin="18,0,0,0"/></DockPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="WORKFLOW SUPERVISION / RETAINED LIVE OUTPUT" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Grid.Row="1" Text="All runs revalidate the exact approval and action catalog. Output, errors, cancellation, retries, and terminal evidence are retained." Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,8"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultText" Text="" FontFamily="Consolas" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></ScrollViewer></Grid></Border><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="WORKSHOP.AI LOCAL GENERATION" Foreground="{StaticResource Green}" FontSize="10" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Create drafts with Workshop's local models. Review and approvals remain in Aegis." FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <ListBox Grid.Row="2" x:Name="WorkshopJobsList" SelectionChanged="WorkshopJobsList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"/>
        <TextBlock Grid.Row="3" x:Name="WorkshopStatusText" Text="Select a generation stage after completing its required reviews." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8"/>
        <StackPanel Grid.Row="4">
          <ComboBox x:Name="WorkshopOperationInput" SelectedIndex="0" Margin="0,0,0,8"><ComboBoxItem Content="Design plan" Tag="design_plan"/><ComboBoxItem Content="Test plans" Tag="test_plans"/><ComboBoxItem Content="Implementation" Tag="implementation"/></ComboBox>
          <WrapPanel><Button x:Name="SendWorkshopButton" Content="Send to Workshop" Click="SendToWorkshopButton_Click" Margin="0,0,8,8"/><Button x:Name="WorkshopJobActionButton" Content="Cancel job" Click="CancelWorkshopButton_Click" Margin="0,0,0,8" IsEnabled="False"/></WrapPanel>
        </StackPanel>
      </Grid>
    </Border></Grid>
    <DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="UpdatedText" Text="" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Refresh" Click="RefreshButton_Click"/><Button Content="Review" Click="ApproveButton_Click"/><Button Content="Schedule" Click="ScheduleButton_Click"/><Button Content="Run" Click="RunButton_Click"/><Button Content="Cancel Run" Click="CancelRunButton_Click"/><Button Content="Retry" Click="RetryRunButton_Click"/><Button Content="Pause" Click="PauseButton_Click"/><Button Content="Resume" Click="ResumeButton_Click"/><Button Content="Stop" Click="StopButton_Click" Margin="0"/></StackPanel></DockPanel>
  </Grid>
</Window>
