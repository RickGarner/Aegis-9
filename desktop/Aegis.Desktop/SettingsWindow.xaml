<Window x:Class="Aegis.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A.E.G.I.S.-9 · Configuration" Height="760" Width="700" MinHeight="560" MinWidth="620" WindowStartupLocation="CenterOwner" Background="#030A0F">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#B20A1821"/><SolidColorBrush x:Key="Raised" Color="#D0112733"/><SolidColorBrush x:Key="Line" Color="#6638C9EA"/><SolidColorBrush x:Key="Text" Color="#D9F7FF"/><SolidColorBrush x:Key="Muted" Color="#6A9BA9"/><SolidColorBrush x:Key="Green" Color="#4DE7FF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Green}"/><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="ComboBox"><Setter Property="IsEditable" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="Foreground" Value="#172126"/><Setter Property="Background" Value="#E7F0ED"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="TextElement.Foreground" Value="#172126"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#172126"/><Setter Property="Background" Value="#E7F0ED"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#35694F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#172126"/><Setter Property="Background" Value="#B5F1D2"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="CONFIGURATION / OPERATOR CONTROL" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="A.E.G.I.S.-9 SETTINGS" Foreground="{StaticResource Green}" FontSize="26" FontWeight="Light" Margin="0,4,0,0"/><TextBlock Text="GUARDIAN INTELLIGENCE CONFIGURATION" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="MONITORED SERVERS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ServerPathText" Text="config/monitored-servers.json" Margin="0,7,0,10"/><Button Content="Open server list in editor" Click="OpenServerListButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="ASSISTANT PRESENCE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Configure avatar identity, profile, and local offline voice assignments." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,10"/><DockPanel Margin="0,0,0,8"><TextBlock Text="Display name" VerticalAlignment="Center" Width="120"/><TextBox x:Name="AvatarNameInput" Text="A.E.G.I.S.-9" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Presence theme" VerticalAlignment="Center" Width="120"/><ComboBox x:Name="AvatarThemeInput" SelectedValuePath="Content" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Amber"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Active avatar" VerticalAlignment="Center" Width="120"/><ComboBox x:Name="AvatarChoiceInput" SelectedValuePath="Tag" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ComboBoxItem Content="Male development avatar" Tag="aegis9-male"/><ComboBoxItem Content="Female development avatar" Tag="aegis9-female"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="3D profile" VerticalAlignment="Center" Width="120"/><ComboBox x:Name="AvatarProfileInput" SelectedValuePath="Content" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ComboBoxItem Content="male"/><ComboBoxItem Content="female"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Male voice" VerticalAlignment="Center" Width="120"/><TextBox x:Name="MaleVoiceInput" Text="am_fenrir" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Female voice" VerticalAlignment="Center" Width="120"/><TextBox x:Name="FemaleVoiceInput" Text="af_heart" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><CheckBox x:Name="UseThreeDAvatarCheckBox" Content="Enable local 3D avatar host (falls back automatically when unavailable)" Foreground="{StaticResource Text}" Margin="0,0,0,6"/><CheckBox x:Name="EnableLipSyncCheckBox" Content="Enable development lip sync" Foreground="{StaticResource Text}" Margin="0,0,0,8"/><Button Content="Preview selected voice" Click="PreviewVoiceButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="VOICE OUTPUT" Foreground="{StaticResource Muted}" FontSize="10"/><CheckBox x:Name="EnableStartupNotificationsCheckBox" Content="Speak initial startup notifications" Foreground="{StaticResource Text}" Margin="0,8,0,6"/><CheckBox x:Name="EnableVoiceResponsesCheckBox" Content="Speak assistant voice responses" Foreground="{StaticResource Text}" Margin="0,0,0,6"/><TextBlock Text="Startup notifications and assistant responses are controlled independently. Voice preview remains available." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="VOICE INPUT" Foreground="{StaticResource Muted}" FontSize="10"/><CheckBox x:Name="AutoSubmitVoiceCheckBox" Content="Automatically submit recognized voice commands" Foreground="{StaticResource Text}" Margin="0,8,0,6"/><CheckBox x:Name="EnableWakePhraseCheckBox" Content="Enable local wake phrase while A.E.G.I.S.-9 is open" Foreground="{StaticResource Text}" Margin="0,0,0,8"/><DockPanel><TextBlock Text="Wake phrase" VerticalAlignment="Center" Width="120"/><TextBox x:Name="WakePhraseInput" Text="AEGIS-9" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><TextBlock Text="Voice recognition uses the local Faster-Whisper service. Audio is not sent to a cloud transcription service." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="COMPOSER" Foreground="{StaticResource Muted}" FontSize="10"/><CheckBox x:Name="EnterSendsMessageCheckBox" Content="Press Enter to send a message" Foreground="{StaticResource Text}" Margin="0,8,0,10"/><TextBlock Text="When disabled, Enter inserts a new line. Shift+Enter always inserts a new line when this option is enabled." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="MOVEIT CREDENTIALS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Credentials are stored only in the local git-ignored .env file and are never displayed here." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/><Button Content="Open local .env in editor" Click="OpenEnvironmentButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Text="Changes apply after A.E.G.I.S.-9 restarts." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Save changes" Click="SaveButton_Click" IsDefault="True" Margin="0,0,8,0"/><Button Content="Cancel" Click="CancelButton_Click" IsCancel="True" Margin="0,0,8,0"/><Button Content="Close" Click="CloseButton_Click" Margin="0"/></StackPanel></DockPanel>
  </Grid>
</Window>
