<Window x:Class="Aegis.Desktop.WorkflowDesignReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 · Workflow Design Review" Height="780" Width="980" MinHeight="650" MinWidth="820" WindowStartupLocation="CenterOwner" Background="#030A0F">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9F7FF"/></Style><Style TargetType="TextBox"><Setter Property="Foreground" Value="#D9F7FF"/><Setter Property="Background" Value="#A908161F"/><Setter Property="BorderBrush" Value="#6638C9EA"/><Setter Property="Padding" Value="9"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="#4DE7FF"/><Setter Property="Background" Value="#D0112733"/><Setter Property="BorderBrush" Value="#6638C9EA"/><Setter Property="Padding" Value="12,7"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="WORKFLOW DESIGN / REQUIRED REVIEW" Foreground="#4DE7FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HeadingText" FontSize="28" Margin="0,5,0,4"/><TextBlock x:Name="ReviewStatusText" Foreground="#FFFFB84D" FontWeight="Bold"/><TextBlock Text="Review the proposed plan. Submit each answer separately. Update Draft remains locked until every required answer has been submitted." Foreground="#6A9BA9" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions><Border Background="#B20A1821" BorderBrush="#6638C9EA" BorderThickness="1" Padding="15" Margin="0,0,7,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="PROPOSED WORKFLOW PLAN" Foreground="#6A9BA9" FontSize="10"/><TextBlock x:Name="ModelText" Foreground="#4DE7FF" FontSize="10" Margin="0,4,0,10"/></StackPanel><TextBox x:Name="PlanText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border><Border Grid.Column="1" Background="#B20A1821" BorderBrush="#88FFB84D" BorderThickness="1" Padding="15" Margin="7,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="QUESTIONS / INFORMATION REQUESTS" Foreground="#FFFFB84D" FontSize="10" FontWeight="Bold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel x:Name="QuestionsPanel"/></ScrollViewer></Grid></Border></Grid>
  <DockPanel Grid.Row="2"><TextBlock x:Name="OperationStatusText" Foreground="#FFFFB84D" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="CLOSE" Click="CloseButton_Click" Margin="0,0,8,0"/><Button x:Name="UpdateDraftButton" Content="UPDATE DRAFT" IsEnabled="False" Click="UpdateDraftButton_Click"/></StackPanel></DockPanel>
 </Grid>
</Window>
