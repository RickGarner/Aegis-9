<Window x:Class="Aegis.Desktop.StartupSplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="A.E.G.I.S.-9 · Guardian Boot Chamber" Width="1040" Height="760" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#02070C">
 <Window.Resources>
  <SolidColorBrush x:Key="Cyan" Color="#4DE7FF"/><SolidColorBrush x:Key="Dim" Color="#7DA8B5"/><SolidColorBrush x:Key="Amber" Color="#FFB74D"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D9F8FF"/><Setter Property="Background" Value="#1513232D"/><Setter Property="BorderBrush" Value="#884DE7FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Storyboard x:Key="Orbit"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="360" Duration="0:0:18" RepeatBehavior="Forever"/></Storyboard>
  <Storyboard x:Key="Pulse" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="Opacity" To=".42" Duration="0:0:.65"/></Storyboard>
 </Window.Resources>
 <Grid MouseLeftButtonDown="Root_MouseLeftButtonDown"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.Background><RadialGradientBrush Center=".5,.38" RadiusX=".78" RadiusY=".8"><GradientStop Color="#112B4050"/><GradientStop Color="#06121B" Offset=".47"/><GradientStop Color="#02070C" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Border Margin="16" BorderBrush="#5638C9EA" BorderThickness="1"><Grid/></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="44,28,44,24" MinHeight="550"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="270"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel HorizontalAlignment="Center"><TextBlock Text="A . E . G . I . S . - 9" Foreground="{StaticResource Cyan}" FontFamily="Bahnschrift SemiCondensed" FontSize="38" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock Text="ADAPTIVE ENHANCED GUARDIAN INTELLIGENCE SYSTEM  ·  NINTH GENERATION" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
   <Grid Grid.Row="1" Width="260" Height="260" HorizontalAlignment="Center"><Ellipse Width="242" Height="242" Stroke="#4838C9EA" StrokeThickness="1" StrokeDashArray="3 7" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard Storyboard="{StaticResource Orbit}"/></EventTrigger></Ellipse.Triggers></Ellipse><Ellipse Width="214" Height="214" Stroke="#304DE7FF" StrokeThickness="2" StrokeDashArray="1 12"/>
    <Border Width="210" Height="236" CornerRadius="105" Background="#D9081821" BorderBrush="#984DE7FF" BorderThickness="1" ClipToBounds="True"><Grid><Grid x:Name="AvatarFallback"><Ellipse Width="142" Height="142" Stroke="#604DE7FF" StrokeThickness="1" StrokeDashArray="2 8"/><Ellipse Width="72" Height="72" Stroke="#7638C9EA" StrokeThickness="2"/><Ellipse Width="18" Height="18" Fill="#AA4DE7FF"><Ellipse.Effect><DropShadowEffect Color="#4DE7FF" BlurRadius="20" ShadowDepth="0" Opacity=".9"/></Ellipse.Effect></Ellipse><StackPanel VerticalAlignment="Bottom" Margin="16,0,16,22"><TextBlock x:Name="AvatarFallbackTitle" Text="AEGIS AO MODEL" Foreground="#DDF9FF" FontSize="10" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="AvatarFallbackDetail" Text="VISUAL CORE INITIALIZING" Foreground="{StaticResource Dim}" FontSize="8" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel></Grid><wv2:WebView2 x:Name="AvatarWebView" Visibility="Collapsed"/></Grid></Border>
    <TextBlock Text="A E G I S   A O   M O D E L" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
   </Grid>
   <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="F . E . R . A . L ." Foreground="#DDF9FF" FontFamily="Bahnschrift SemiCondensed" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="FEDERATED EXECUTION, REASONING, AND ADAPTIVE LEARNING" Foreground="{StaticResource Dim}" FontSize="10" Margin="0,4"/></StackPanel>
   <Border Grid.Row="3" MaxWidth="820" Background="#A807141D" BorderBrush="#5038C9EA" BorderThickness="1" Padding="14"><StackPanel><DockPanel Margin="2,0,2,10"><TextBlock Text="STARTUP INTEGRITY CHECKS" Foreground="#CDEFF5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="SequenceText" Text="SEQUENCE INITIALIZING" Foreground="{StaticResource Dim}" FontSize="10" HorizontalAlignment="Right"/></DockPanel><ItemsControl x:Name="ChecksList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="190"/><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{Binding Brush}" FontSize="14"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D8EFF4"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="10" FontWeight="Bold"/><TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="#7DA8B5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Grid.Column="4" Text="{Binding Timing}" Foreground="#527A86" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </Grid></ScrollViewer>
  <Border Grid.Row="1" Background="#F0040C12" BorderBrush="#5638C9EA" BorderThickness="0,1,0,0" Padding="12,8"><StackPanel><TextBlock x:Name="DecisionText" Text="Guardian protocols are examining the local command center." Foreground="{StaticResource Dim}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,3"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ContinueButton" Content="CONTINUE" Visibility="Collapsed" IsDefault="True" Click="Continue_Click"/><Button x:Name="DegradedButton" Content="CONTINUE IN DEGRADED MODE" Visibility="Collapsed" Click="Degraded_Click"/><Button x:Name="DiagnosticButton" Content="GENERATE DIAGNOSTIC LOG" Visibility="Collapsed" Click="Diagnostic_Click"/><Button x:Name="CloseButton" Content="CLOSE A.E.G.I.S.-9" IsCancel="True" Click="Close_Click"/></StackPanel></StackPanel></Border>
 </Grid>
</Window>
