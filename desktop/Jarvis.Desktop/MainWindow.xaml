<Window x:Class="Jarvis.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Command Center" Height="820" Width="1180" MinHeight="620" MinWidth="820" WindowStartupLocation="CenterScreen" Background="#10161A">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#10161A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#172126" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1D2A30" />
        <SolidColorBrush x:Key="LineBrush" Color="#30434A" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7F0ED" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8BA29D" />
        <SolidColorBrush x:Key="GreenBrush" Color="#5FD39A" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/></Style>
        <Style x:Key="HealthStatusStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource GreenBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="Foreground" Value="#FFEB8278"/></DataTrigger></Style.Triggers></Style>
        <Storyboard x:Key="AvatarPulse" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:1.8"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:1.8"/></Storyboard>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="JARVIS" FontSize="32" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/><TextBlock Text="COMMAND CENTER" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Chat, issue commands, and coordinate work." FontSize="14" Margin="0,12,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#20362D" BorderBrush="#35694F" BorderThickness="1" Padding="10,6" Margin="0,0,10,0"><TextBlock Text="NATIVE WINDOWS SHELL" Foreground="{StaticResource GreenBrush}" FontSize="10" FontWeight="Bold"/></Border><Button Content="New conversation" Click="NewConversationButton_Click"/><Button Content="Avatar host" Click="OpenAvatarHostButton_Click"/><Button Content="Settings" Click="SettingsButton_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,14"><StackPanel DockPanel.Dock="Left"><TextBlock Text="DIRECT COMMAND" FontSize="19" FontWeight="Bold"/><TextBlock Text="LOCAL ASSISTANT CHANNEL" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><TextBlock Text="READY" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="AvatarPresence" Grid.Row="0" Background="#12252A" BorderBrush="#35694F" BorderThickness="1" Padding="12" MouseEnter="AvatarPresence_MouseEnter" MouseLeave="AvatarPresence_MouseLeave" MouseLeftButtonUp="AvatarPresence_MouseLeftButtonUp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="112" Height="112" Stroke="#35694F" StrokeThickness="1" Opacity="0.8"/><Canvas Width="108" Height="108"><Path x:Name="AvatarAccent" Data="M 18,104 C 24,78 84,78 90,104 Z" Fill="#315F47" Stroke="#B5F1D2" StrokeThickness="1"/><Rectangle Width="16" Height="18" Canvas.Left="46" Canvas.Top="66" Fill="#D39B78" RadiusX="6" RadiusY="6"/><Ellipse x:Name="AvatarCore" Width="58" Height="66" Canvas.Left="25" Canvas.Top="17" Fill="#D9A27F" Stroke="#F1C8A8" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard Storyboard="{StaticResource AvatarPulse}"/></EventTrigger></Ellipse.Triggers></Ellipse><Path Data="M 23,43 C 18,18 31,7 54,10 C 77,7 90,22 84,43 C 77,29 67,23 55,24 C 42,23 32,29 23,43 Z" Fill="#34383B"/><Ellipse Width="5" Height="7" Canvas.Left="39" Canvas.Top="44" Fill="#172126"/><Ellipse Width="5" Height="7" Canvas.Left="64" Canvas.Top="44" Fill="#172126"/><Path Data="M 54,47 L 51,56 L 57,56" Stroke="#9D644F" StrokeThickness="1" Fill="Transparent"/><Path Data="M 45,62 Q 54,68 63,62" Stroke="#8A4C4D" StrokeThickness="1.4" Fill="Transparent"/><Path Data="M 25,40 Q 19,43 24,53" Stroke="#D9A27F" StrokeThickness="3"/><Path Data="M 83,40 Q 89,43 84,53" Stroke="#D9A27F" StrokeThickness="3"/></Canvas></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="AvatarNameText" Text="JARVIS PRESENCE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="AvatarStatusText" Text="READY FOR COMMANDS" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Text responses are shown below. Voice input and speech output will plug into this same state surface." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                        <ListBox x:Name="ConversationList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="14"><ListBox.ItemTemplate><DataTemplate><TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" IsTabStop="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="4,5" FontSize="14"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="CommandInput" Grid.Row="0" MinHeight="70" Padding="12" AcceptsReturn="True" TextWrapping="Wrap" Background="#0F171B" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontSize="14" PreviewKeyDown="CommandInput_PreviewKeyDown"/><DockPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="ComposerHintText" Text="Enter to send · Shift+Enter for a new line" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Button Content="Send" Width="72" Click="IssueCommandButton_Click" DockPanel.Dock="Right"/></DockPanel></Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="Independent command surface" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Monitoring and workflow windows stay separate from this conversation." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="Edit monitoring list and MoveIT credentials" Click="SettingsButton_Click" Margin="0,12,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="DEPENDENCIES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="Startup health" FontSize="15" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Reachability of local model services is checked when the command center opens." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/><ItemsControl x:Name="HealthList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource HealthStatusStyle}" FontWeight="Bold" FontSize="10" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="MONITORING" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="MoveIT Automation" FontSize="15" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Live task catalog and task health" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,10"/><Button Content="Open MoveIT monitor" Click="OpenMoveItWindow_Click" Margin="0,0,0,12"/><TextBlock Text="Server Status" FontSize="15" FontWeight="Bold"/><TextBlock Text="Resources, services, and audit events" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,10"/><Button Content="Open Server Status" Click="OpenServerWindow_Click" Margin="0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" AllowDrop="True" DragOver="ContextDropZone_DragOver" Drop="ContextDropZone_Drop"><StackPanel><TextBlock Text="FILE INTAKE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="Attach local context" FontSize="15" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Upload supported files and include their extracted text with the next command." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,10"/><Button Content="Choose files" Click="ChooseFilesButton_Click" Margin="0,0,0,8"/><ListBox x:Name="StagedFileList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="150"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Button Content="Preview" Tag="{Binding}" Click="PreviewFileButton_Click" DockPanel.Dock="Right" Padding="5,2"/><Button Content="Remove" Tag="{Binding}" Click="RemoveFileButton_Click" DockPanel.Dock="Right" Padding="5,2"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ALERTS AND ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="Operator trail" FontSize="15" FontWeight="Bold" Margin="0,7,0,0"/><ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="110"/><ListBox x:Name="AlertList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="125"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="10"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/></StackPanel><Button Content="Resolve" Tag="{Binding}" Click="ResolveAlertButton_Click" DockPanel.Dock="Right" Padding="5,2"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="WORKFLOWS" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="Native supervised automation" FontSize="15" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="Create, approve, pause, resume, stop, and inspect workflows without leaving the Windows application." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBox x:Name="WorkflowTitleInput" MinHeight="30" Padding="8" Background="#0F171B" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/><TextBox x:Name="WorkflowDescriptionInput" MinHeight="48" Padding="8" Margin="0,8,0,10" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F171B" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/><Button Content="Create workflow" Click="CreateWorkflowButton_Click" Margin="0,0,0,10"/><ListBox x:Name="WorkflowList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="180"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding State}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Approve" Tag="{Binding}" Click="ApproveWorkflowButton_Click" Padding="7,5"/><Button Content="Open" Tag="{Binding}" Click="OpenWorkflowButton_Click" Padding="7,5"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            </StackPanel>
        </Grid>
        <StatusBar Grid.Row="2" Background="Transparent" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"><StatusBarItem><TextBlock x:Name="ConnectionText" Text="Local command center · backend ready"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="Monitoring runs in separate windows"/></StatusBarItem><StatusBarItem HorizontalContentAlignment="Right"><TextBlock Text="Operator controlled" Foreground="{StaticResource GreenBrush}"/></StatusBarItem></StatusBar>
    </Grid>
</Window>
