<Window x:Class="Jarvis.Desktop.AvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Jarvis Avatar Host" Height="640" Width="520" MinHeight="420" MinWidth="380" WindowStartupLocation="CenterOwner" Background="#10161A">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#172126" BorderBrush="#30434A" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="3D AVATAR HOST" Foreground="#5FD39A" FontSize="13" FontWeight="Bold"/>
                <TextBlock x:Name="SubHeaderText" Text="Loading manifest" Foreground="#8BA29D" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="AvatarWebView" Visibility="Collapsed"/>
            <Border x:Name="FallbackPanel" Background="#172126" BorderBrush="#30434A" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="3D avatar unavailable" Foreground="#E7F0ED" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="FallbackDetailText" Text="" Foreground="#8BA29D" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Drop your licensed model into Assets/Avatars/&lt;profile&gt;/ and update manifest.json." Foreground="#8BA29D" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="LicenseText" Text="" Foreground="#8BA29D" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="Close" Width="80" DockPanel.Dock="Right" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
