<Window x:Class="Jarvis.Desktop.AvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JARVIS · Avatar Presence Core" Height="640" Width="520" MinHeight="420" MinWidth="380" WindowStartupLocation="CenterOwner" Background="#030A0F">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#B20A1821" BorderBrush="#6638C9EA" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="AVATAR / BIOMETRIC PRESENCE CORE" Foreground="#4DE7FF" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubHeaderText" Text="Loading local manifest" Foreground="#6A9BA9" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="AvatarWebView" Visibility="Collapsed"/>
            <Border x:Name="FallbackPanel" Background="#B20A1821" BorderBrush="#6638C9EA" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="3D avatar unavailable" Foreground="#D9F7FF" FontSize="20" FontWeight="Light"/>
                    <TextBlock x:Name="FallbackDetailText" Text="" Foreground="#6A9BA9" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Validate the selected local avatar profile, GLB, manifest, and WebView2 runtime." Foreground="#6A9BA9" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="LicenseText" Text="" Foreground="#6A9BA9" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="Close" Width="80" DockPanel.Dock="Right" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
