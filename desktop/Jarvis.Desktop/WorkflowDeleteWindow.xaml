<Window x:Class="Jarvis.Desktop.WorkflowDeleteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 · Archive Workflow" Height="440" Width="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#030A0F">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DESTRUCTIVE ACTION / FINAL VERIFICATION" Foreground="#FFFFB84D" FontSize="10" FontWeight="Bold"/><TextBlock Text="Archive workflow" Foreground="#D9F7FF" FontSize="28" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Background="#B20A1821" BorderBrush="#88FFB84D" BorderThickness="1" Padding="16" Margin="0,18,0,14"><StackPanel><TextBlock x:Name="DetailsText" Foreground="#D9F7FF" TextWrapping="Wrap" FontSize="14"/><TextBlock Text="This removes the workflow from active lists but retains its audit history. Running or paused workflows cannot be archived." Foreground="#6A9BA9" TextWrapping="Wrap" Margin="0,14,0,14"/><CheckBox x:Name="ConfirmCheck" Content="I have reviewed the workflow details and want to archive it." Foreground="#D9F7FF"/><TextBlock Text="Type ARCHIVE to confirm" Foreground="#6A9BA9" Margin="0,14,0,4"/><TextBox x:Name="ConfirmationInput" Background="#A908161F" Foreground="#D9F7FF" BorderBrush="#6638C9EA" Padding="8"/></StackPanel></Border><DockPanel Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#FFFFB84D" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="CANCEL" Click="CancelButton_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="ARCHIVE" Click="ArchiveButton_Click" Padding="12,7"/></StackPanel></DockPanel></Grid>
</Window>
