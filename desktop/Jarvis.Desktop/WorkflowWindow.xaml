<Window x:Class="Jarvis.Desktop.WorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Workflow" Height="520" Width="760" MinHeight="420" MinWidth="620" WindowStartupLocation="CenterOwner" Background="#10161A">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#172126"/><SolidColorBrush x:Key="Raised" Color="#1D2A30"/><SolidColorBrush x:Key="Line" Color="#30434A"/><SolidColorBrush x:Key="Text" Color="#E7F0ED"/><SolidColorBrush x:Key="Muted" Color="#8BA29D"/><SolidColorBrush x:Key="Green" Color="#5FD39A"/><SolidColorBrush x:Key="Amber" Color="#F2B35D"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18"><StackPanel DockPanel.Dock="Left"><TextBlock Text="SUPERVISED WORKFLOW" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="TitleText" Text="Loading workflow" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="DescriptionText" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="StateText" Text="LOADING" Foreground="{StaticResource Amber}" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,14"><DockPanel><TextBlock x:Name="PlacementText" Text="Monitor placement loading" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ConnectionText" Text="CONNECTING" Foreground="{StaticResource Amber}" DockPanel.Dock="Right" Margin="18,0,0,0"/></DockPanel></Border>
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="WORKFLOW SUPERVISION" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="This native window is the workflow's operator surface. All state changes are sent to the local Jarvis backend and remain approval-gated." Foreground="{StaticResource Text}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="ResultText" Text="" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
    <DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="UpdatedText" Text="" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Refresh" Click="RefreshButton_Click"/><Button Content="Approve" Click="ApproveButton_Click"/><Button Content="Pause" Click="PauseButton_Click"/><Button Content="Resume" Click="ResumeButton_Click"/><Button Content="Stop" Click="StopButton_Click" Margin="0"/></StackPanel></DockPanel>
  </Grid>
</Window>
