<Window x:Class="Jarvis.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Settings" Height="420" Width="620" MinHeight="360" MinWidth="520" WindowStartupLocation="CenterOwner" Background="#10161A">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#172126"/><SolidColorBrush x:Key="Raised" Color="#1D2A30"/><SolidColorBrush x:Key="Line" Color="#30434A"/><SolidColorBrush x:Key="Text" Color="#E7F0ED"/><SolidColorBrush x:Key="Muted" Color="#8BA29D"/><SolidColorBrush x:Key="Green" Color="#5FD39A"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="JARVIS SETTINGS" Foreground="{StaticResource Green}" FontSize="26" FontWeight="Bold"/><TextBlock Text="LOCAL CONFIGURATION" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Row="1">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="MONITORED SERVERS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ServerPathText" Text="config/monitored-servers.json" Margin="0,7,0,10"/><Button Content="Open server list in editor" Click="OpenServerListButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="ASSISTANT PRESENCE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Configure avatar identity, profile, and local offline voice assignments." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,10"/><DockPanel Margin="0,0,0,8"><TextBlock Text="Display name" VerticalAlignment="Center" Width="120"/><TextBox x:Name="AvatarNameInput" Text="Jarvis" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Presence theme" VerticalAlignment="Center" Width="120"/><ComboBox x:Name="AvatarThemeInput" SelectedValuePath="Content" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Amber"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Active avatar" VerticalAlignment="Center" Width="120"/><ComboBox x:Name="AvatarChoiceInput" SelectedValuePath="Tag" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ComboBoxItem Content="Male development avatar" Tag="jarvis-male-dev"/><ComboBoxItem Content="Female development avatar" Tag="jarvis-female-dev"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="3D profile" VerticalAlignment="Center" Width="120"/><ComboBox x:Name="AvatarProfileInput" SelectedValuePath="Content" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ComboBoxItem Content="male"/><ComboBoxItem Content="female"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Male voice" VerticalAlignment="Center" Width="120"/><TextBox x:Name="MaleVoiceInput" Text="am_fenrir" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Female voice" VerticalAlignment="Center" Width="120"/><TextBox x:Name="FemaleVoiceInput" Text="af_heart" Padding="6" Background="{StaticResource Raised}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/></DockPanel><CheckBox x:Name="UseThreeDAvatarCheckBox" Content="Enable local 3D avatar host (falls back automatically when unavailable)" Foreground="{StaticResource Text}" Margin="0,0,0,6"/><CheckBox x:Name="EnableLipSyncCheckBox" Content="Enable development lip sync" Foreground="{StaticResource Text}" Margin="0,0,0,8"/><Button Content="Preview selected voice" Click="PreviewVoiceButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="COMPOSER" Foreground="{StaticResource Muted}" FontSize="10"/><CheckBox x:Name="EnterSendsMessageCheckBox" Content="Press Enter to send a message" Foreground="{StaticResource Text}" Margin="0,8,0,10"/><TextBlock Text="When disabled, Enter inserts a new line. Shift+Enter always inserts a new line when this option is enabled." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="MOVEIT CREDENTIALS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Credentials are stored only in the local git-ignored .env file and are never displayed here." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/><Button Content="Open local .env in editor" Click="OpenEnvironmentButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel>
    <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Text="Changes apply after Jarvis restarts." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Close" Click="CloseButton_Click" DockPanel.Dock="Right" Margin="0"/></DockPanel>
  </Grid>
</Window>
