<Window x:Class="Jarvis.Desktop.WorkflowScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 · Workflow Schedule" Height="650" Width="760" WindowStartupLocation="CenterOwner" Background="#030A0F">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9F7FF"/></Style><Style TargetType="TextBox"><Setter Property="Foreground" Value="#D9F7FF"/><Setter Property="Background" Value="#A908161F"/><Setter Property="BorderBrush" Value="#6638C9EA"/><Setter Property="Padding" Value="8"/></Style></Window.Resources><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SCHEDULE / CONDITIONS" Foreground="#4DE7FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HeadingText" FontSize="28" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Background="#B20A1821" BorderBrush="#6638C9EA" BorderThickness="1" Padding="16" Margin="0,18,0,14"><ScrollViewer><StackPanel><TextBlock Text="TRIGGER" Foreground="#6A9BA9"/><ComboBox x:Name="TriggerInput" SelectedIndex="1" Margin="0,4,0,10"><ComboBoxItem Content="Once" Tag="once"/><ComboBoxItem Content="Daily" Tag="daily"/><ComboBoxItem Content="Weekly" Tag="weekly"/><ComboBoxItem Content="Interval" Tag="interval"/><ComboBoxItem Content="Manual" Tag="manual"/></ComboBox><TextBlock Text="TIME / INTERVAL EXPRESSION" Foreground="#6A9BA9"/><TextBox x:Name="ExpressionInput" Margin="0,4,0,10"/><TextBlock Text="TIMEZONE" Foreground="#6A9BA9"/><TextBox x:Name="TimezoneInput" Text="America/New_York" Margin="0,4,0,10"/><TextBlock Text="PURPOSE / REASON" Foreground="#6A9BA9"/><TextBox x:Name="ReasonInput" Margin="0,4,0,10"/><TextBlock Text="START CONDITIONS" Foreground="#6A9BA9"/><TextBox x:Name="StartInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,10"/><TextBlock Text="STOP / PAUSE CONDITIONS" Foreground="#6A9BA9"/><TextBox x:Name="StopInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></ScrollViewer></Border><DockPanel Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#FFFFB84D" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="CANCEL" Click="CancelButton_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="SAVE SCHEDULE" Click="SaveButton_Click" Padding="12,7"/></StackPanel></DockPanel></Grid>
</Window>
