<Window x:Class="Jarvis.Desktop.WorkflowScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A.E.G.I.S.-9 · Workflow Schedule" Height="780" Width="780" MinHeight="680" MinWidth="720" WindowStartupLocation="CenterOwner" Background="#030A0F">
  <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9F7FF"/></Style><Style TargetType="TextBox"><Setter Property="Foreground" Value="#D9F7FF"/><Setter Property="Background" Value="#A908161F"/><Setter Property="BorderBrush" Value="#6638C9EA"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Padding" Value="7"/></Style><Style TargetType="DatePicker"><Setter Property="Margin" Value="0,4,0,12"/></Style></Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="SCHEDULE / CONDITIONS" Foreground="#4DE7FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HeadingText" FontSize="28" Margin="0,5,0,0"/><TextBlock Text="Define the complete production date range, daily run window, and recurrence before supervisor approval." Foreground="#6A9BA9" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="#B20A1821" BorderBrush="#6638C9EA" BorderThickness="1" Padding="16" Margin="0,18,0,14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="SCHEDULE TYPE" Foreground="#6A9BA9"/><ComboBox x:Name="TriggerInput" SelectedIndex="0" SelectionChanged="TriggerInput_SelectionChanged"><ComboBoxItem Content="Recurring" Tag="recurring"/><ComboBoxItem Content="Run once" Tag="once"/><ComboBoxItem Content="Manual only" Tag="manual"/></ComboBox>
      <Grid x:Name="CalendarFields"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="START DATE" Foreground="#6A9BA9"/><DatePicker x:Name="StartDateInput"/><TextBlock Text="DAILY START TIME" Foreground="#6A9BA9"/><TextBox x:Name="StartTimeInput" Text="00:00" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="END DATE (OPTIONAL)" Foreground="#6A9BA9"/><DatePicker x:Name="EndDateInput"/><TextBlock Text="DAILY END TIME" Foreground="#6A9BA9"/><TextBox x:Name="EndTimeInput" Text="23:59" Margin="0,4,0,12"/></StackPanel></Grid>
      <Grid x:Name="RecurrenceFields"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RUN EVERY" Foreground="#6A9BA9"/><TextBox x:Name="IntervalValueInput" Text="1" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="INTERVAL UNIT" Foreground="#6A9BA9"/><ComboBox x:Name="IntervalUnitInput" SelectedIndex="2"><ComboBoxItem Content="Minutes" Tag="minutes"/><ComboBoxItem Content="Hours" Tag="hours"/><ComboBoxItem Content="Days" Tag="days"/><ComboBoxItem Content="Weeks" Tag="weeks"/><ComboBoxItem Content="Months" Tag="months"/></ComboBox></StackPanel></Grid>
      <TextBlock Text="TIMEZONE" Foreground="#6A9BA9"/><TextBox x:Name="TimezoneInput" Text="America/New_York" Margin="0,4,0,12"/><TextBlock Text="PURPOSE / REASON" Foreground="#6A9BA9"/><TextBox x:Name="ReasonInput" Margin="0,4,0,12"/>
      <TextBlock Text="START PREREQUISITES" Foreground="#6A9BA9"/><TextBlock Text="Optional: file_exists=path; host_reachable=host:port; env_present=NAME" Foreground="#6A9BA9" FontSize="10" Margin="0,3,0,3"/><TextBox x:Name="StartInput" Height="65" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="STOP / PAUSE CONDITIONS" Foreground="#6A9BA9"/><TextBox x:Name="StopInput" Height="65" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel></ScrollViewer></Border>
    <DockPanel Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#FFFFB84D" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="CANCEL" Click="CancelButton_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="SAVE SCHEDULE" Click="SaveButton_Click" Padding="12,7"/></StackPanel></DockPanel>
  </Grid>
</Window>
