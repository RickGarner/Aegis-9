diff --git a/desktop/Jarvis.Desktop/LocalSpeechRecognitionService.cs b/desktop/Jarvis.Desktop/LocalSpeechRecognitionService.cs
new file mode 100644
index 0000000..f66c7bd
--- /dev/null
+++ b/desktop/Jarvis.Desktop/LocalSpeechRecognitionService.cs
@@ -0,0 +1,127 @@
+using System.Globalization;
+using System.Speech.Recognition;
+
+namespace Jarvis.Desktop;
+
+public sealed class LocalSpeechRecognitionService : IDisposable
+{
+    private readonly object _gate = new();
+    private SpeechRecognitionEngine? _wakeRecognizer;
+    private int _wakeTriggered;
+    private bool _disposed;
+
+    public event EventHandler<int>? AudioLevelChanged;
+    public event EventHandler? WakePhraseRecognized;
+
+    public async Task<SpeechRecognitionResult> ListenOnceAsync(CancellationToken cancellationToken = default)
+    {
+        ThrowIfDisposed();
+        await StopWakePhraseAsync();
+        SpeechRecognitionEngine? recognizer = null;
+        try
+        {
+            recognizer = CreateRecognizer();
+            recognizer.InitialSilenceTimeout = TimeSpan.FromSeconds(8);
+            recognizer.BabbleTimeout = TimeSpan.FromSeconds(4);
+            recognizer.EndSilenceTimeout = TimeSpan.FromMilliseconds(850);
+            recognizer.EndSilenceTimeoutAmbiguous = TimeSpan.FromSeconds(1.4);
+            recognizer.LoadGrammar(new DictationGrammar());
+            recognizer.SetInputToDefaultAudioDevice();
+
+            var completion = new TaskCompletionSource<SpeechRecognitionResult>(TaskCreationOptions.RunContinuationsAsynchronously);
+            recognizer.AudioLevelUpdated += (_, e) => AudioLevelChanged?.Invoke(this, Math.Clamp(e.AudioLevel, 0, 100));
+            recognizer.RecognizeCompleted += (_, e) =>
+            {
+                if (e.Cancelled) completion.TrySetCanceled(cancellationToken);
+                else if (e.Error is not null) completion.TrySetResult(Failure(e.Error.Message));
+                else if (e.Result is null || string.IsNullOrWhiteSpace(e.Result.Text)) completion.TrySetResult(Failure("No speech was detected."));
+                else completion.TrySetResult(new SpeechRecognitionResult
+                {
+                    Success = true,
+                    Text = e.Result.Text.Trim(),
+                    Confidence = e.Result.Confidence,
+                    Detail = $"Recognized locally with {e.Result.Confidence:P0} confidence.",
+                });
+            };
+            using var registration = cancellationToken.Register(() =>
+            {
+                try { recognizer.RecognizeAsyncCancel(); } catch (InvalidOperationException) { }
+            });
+            recognizer.RecognizeAsync(RecognizeMode.Single);
+            return await completion.Task;
+        }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception error) when (error is InvalidOperationException or ArgumentException)
+        {
+            return Failure($"Local speech recognition is unavailable: {error.Message}");
+        }
+        finally
+        {
+            AudioLevelChanged?.Invoke(this, 0);
+            recognizer?.Dispose();
+        }
+    }
+
+    public Task StartWakePhraseAsync(string phrase, CancellationToken cancellationToken = default)
+    {
+        ThrowIfDisposed();
+        if (string.IsNullOrWhiteSpace(phrase)) return Task.CompletedTask;
+        lock (_gate)
+        {
+            if (_wakeRecognizer is not null) return Task.CompletedTask;
+            Interlocked.Exchange(ref _wakeTriggered, 0);
+            cancellationToken.ThrowIfCancellationRequested();
+            var recognizer = CreateRecognizer();
+            var builder = new GrammarBuilder(phrase.Trim()) { Culture = recognizer.RecognizerInfo.Culture };
+            recognizer.LoadGrammar(new Grammar(builder));
+            recognizer.SetInputToDefaultAudioDevice();
+            recognizer.SpeechRecognized += WakeRecognizer_SpeechRecognized;
+            recognizer.RecognizeAsync(RecognizeMode.Multiple);
+            _wakeRecognizer = recognizer;
+        }
+        return Task.CompletedTask;
+    }
+
+    public Task StopWakePhraseAsync()
+    {
+        SpeechRecognitionEngine? recognizer;
+        lock (_gate)
+        {
+            recognizer = _wakeRecognizer;
+            _wakeRecognizer = null;
+        }
+        if (recognizer is not null)
+        {
+            recognizer.SpeechRecognized -= WakeRecognizer_SpeechRecognized;
+            try { recognizer.RecognizeAsyncCancel(); } catch (InvalidOperationException) { }
+            recognizer.Dispose();
+        }
+        return Task.CompletedTask;
+    }
+
+    private void WakeRecognizer_SpeechRecognized(object? sender, SpeechRecognizedEventArgs e)
+    {
+        if (e.Result.Confidence >= 0.60f && Interlocked.Exchange(ref _wakeTriggered, 1) == 0)
+            WakePhraseRecognized?.Invoke(this, EventArgs.Empty);
+    }
+
+    private static SpeechRecognitionEngine CreateRecognizer()
+    {
+        var installed = SpeechRecognitionEngine.InstalledRecognizers();
+        var info = installed.FirstOrDefault(item => item.Culture.Equals(CultureInfo.CurrentUICulture))
+            ?? installed.FirstOrDefault(item => item.Culture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase))
+            ?? installed.FirstOrDefault()
+            ?? throw new InvalidOperationException("No Windows speech recognition language is installed.");
+        return new SpeechRecognitionEngine(info);
+    }
+
+    private static SpeechRecognitionResult Failure(string detail) => new() { Detail = detail };
+    private void ThrowIfDisposed() => ObjectDisposedException.ThrowIf(_disposed, this);
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        StopWakePhraseAsync().GetAwaiter().GetResult();
+        _disposed = true;
+    }
+}
