# Example environment configuration for Jarvis.
# Copy this file to .env in the project root and update as needed.
# Actual variable names are read by backend/app/config.py (JARVIS_* prefix).

# auto selects the work server when 10.30.75.229:1234 is reachable; otherwise it uses local LM Studio.
JARVIS_ENVIRONMENT=auto
JARVIS_PROVIDER=lmstudio
# Leave unset to derive the endpoint from JARVIS_ENVIRONMENT.
# JARVIS_PROVIDER_BASE_URL=http://127.0.0.1:1234/v1
JARVIS_MODEL=qwen3-coder-30b-a3b-instruct
JARVIS_FALLBACK_MODEL=qwen2.5-coder-7b-instruct
JARVIS_PRIMARY_MODEL_TIMEOUT_SECONDS=120
JARVIS_REQUEST_TIMEOUT_SECONDS=180
JARVIS_PROVIDER_DISCOVERY_ENABLED=true
JARVIS_REMOTE_PROVIDER_HOST=10.30.75.229
JARVIS_LOCAL_PROVIDER_HOST=127.0.0.1
JARVIS_PROVIDER_DISCOVERY_TIMEOUT_SECONDS=2.5
JARVIS_PROVIDER_RETRY_COUNT=1
JARVIS_PROVIDER_PREFERENCE=lmstudio,ollama,litellm
# Required when LiteLLM has a master key. Keep the real value only in .env.
JARVIS_LITELLM_API_KEY=
JARVIS_WHISPER_MODEL=small.en
JARVIS_WHISPER_DEVICE=auto
JARVIS_WHISPER_COMPUTE_TYPE=auto
JARVIS_MAX_RESPONSE_TOKENS=2048
JARVIS_WORKFLOW_WINDOW_LIMIT=6
JARVIS_MAX_UPLOAD_BYTES=26214400
JARVIS_WORKFLOW_ARTIFACT_ROOT=storage/workflow-artifacts
JARVIS_WORKFLOW_TEST_TIMEOUT_SECONDS=30
JARVIS_WORKFLOW_TEST_OUTPUT_LIMIT=64000
JARVIS_SERVER_INVENTORY_PATH=config/monitored-servers.json

# Xerox FreeFlow Core portal monitoring. Add the exact URLs tomorrow in
# config/freeflow-servers.json. Keep TLS verification enabled when possible.
JARVIS_FREEFLOW_INVENTORY_PATH=config/freeflow-servers.json
JARVIS_FREEFLOW_TIMEOUT_SECONDS=10
JARVIS_FREEFLOW_VERIFY_TLS=true

# Qualys VM/VMDR read-only monitoring. Store credentials only in local .env.
# JARVIS_QUALYS_BASE_URL=https://qualysapi.example.com
# JARVIS_QUALYS_USERNAME=
# JARVIS_QUALYS_PASSWORD=
JARVIS_QUALYS_VERIFY_TLS=true
JARVIS_QUALYS_MINIMUM_SEVERITY=4
JARVIS_QUALYS_MAX_FINDINGS=200
JARVIS_LITELLM_BASE_URL=http://10.30.75.229:4000/v1

# MoveIT read-only monitoring. Credentials must be supplied through local secrets or environment variables.
JARVIS_MOVEIT_SERVERS=BSOAUTALB002,BSOAUTALB001
# Set these in the local, git-ignored .env file. Do not commit real credentials.
# JARVIS_MOVEIT_USERNAME=domain\\service-account
# JARVIS_MOVEIT_PASSWORD=
JARVIS_MOVEIT_VERIFY_TLS=true
JARVIS_MOVEIT_TASK_POLL_SECONDS=300
JARVIS_MOVEIT_LOG_ROOT=\\BSOAUTALB002\c$\ProgramData\Ipswitch\Automation\Logs

# Internal alert relay. Keep these values local/configurable before production rollout.
JARVIS_ALERT_SMTP_SERVER=10.30.67.82
JARVIS_ALERT_SMTP_PORT=25
JARVIS_ALERT_EMAIL_FROM=servermonitor@bsoc.local
JARVIS_ALERT_EMAIL_TO=admin@bsoc.local
JARVIS_ALERT_EMAIL_SSL=false

# To force the work environment:
# JARVIS_ENVIRONMENT=work
